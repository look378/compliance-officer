# 企业化配置样例（复制到 .runtime/.lemonclaw/.env 或框架侧 .lemonclaw/.env 即可生效）
#
# 说明：
#   - 这里只有"上线前必须显式确认"的开关与连接器配置；LLM 密钥等由 deploy-runtime.ps1 注入
#   - 改完执行：pwsh -File scripts/d0/run-all-gates.ps1 与 pytest，全绿再上线
#   - 详细契约（字段映射/失败语义/验收口径）：docs/13-企业系统对接契约.md
#   - 未列出的键请勿臆造：写错取值会被 prod_config.validate() 拦下并拒绝启动（刻意设计）

# ============================================================ 认证
# demo：本机演示（演示令牌 + X-Role 头）。绑定非回环地址时会被拒绝启动。
# jwt ：账号密码登录 + JWT 令牌（生产推荐；必须同时设置 JWT_SECRET）
# sso ：企业单点登录 OIDC（与本地账号并存；详见 docs/15-企业SSO对接.md）
AUTH_MODE=demo
# AUTH_MODE=jwt|sso 时必填，长度 ≥16（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
# JWT_SECRET=
TOKEN_TTL_MIN=480
# 演示令牌（仅 demo 模式使用；生产请改掉或改用 jwt/sso）
GATEWAY_AUTH_TOKEN=local-dev-token

# ---- 企业 SSO（AUTH_MODE=sso 时启用）----
# OIDC_ISSUER=https://sso.corp.example/realms/corp
# OIDC_CLIENT_ID=compliance-officer
# OIDC_CLIENT_SECRET=<机密客户端才需要；公开客户端留空>
# OIDC_REDIRECT_URI=http://127.0.0.1:8790/api/v1/auth/sso/callback
# OIDC_SCOPES=openid profile email
# OIDC_ROLE_CLAIM=roles                      # 支持点号路径：realm_access.roles / groups
# OIDC_ROLE_MAP={"compliance-supervisor":"supervisor","compliance-admin":"admin","compliance-specialist":"specialist"}
# OIDC_DEFAULT_ROLE=specialist
# OIDC_ADMIN_EMAILS=ciso@corp.example        # 可选：管理员邮箱兜底白名单
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISPLAY_CLAIM=name
# OIDC_AUTO_PROVISION=true                   # 首次登录自动建档
# OIDC_JWKS_TTL_S=600
# OIDC_TIMEOUT_S=15
# OIDC_VERIFY_TLS=true
# OIDC_CLOCK_SKEW_S=60

# ============================================================ 存储
# sqlite：单文件，开箱即用（默认）
# pg    ：PostgreSQL（本项目自有表：待办/审计/账号/令牌撤销/登录退避 → 真正落 PG）
#         需要驱动：pip install "psycopg[binary]"；部署与验收见 docs/16-PostgreSQL部署.md
#         注意：框架自有的工作流运行态仍写 SQLite（不改框架源码），详见该文档 §1
DB_MODE=sqlite
# DB_MODE=pg 时必填
# DATABASE_URL=postgresql://compliance:<强口令>@127.0.0.1:5432/compliance

# ============================================================ 合同来源（三选一）
# 1) mock：本项目自带 Mock OA（含故障注入），用于演示与自检
CONTRACT_SOURCE=mock
MOCK_URL=http://127.0.0.1:8780

# 2) dir：共享盘 / 本地收件目录（企业最常见）
# CONTRACT_SOURCE=dir
# CONTRACT_DIR=\\fileserver\compliance\inbox
# CONTRACT_DIR_RECURSIVE=false

# 3) http：OA / 合同库 REST 接口（字段名不同就改映射）
# CONTRACT_SOURCE=http
# OA_BASE_URL=https://oa.corp.example
# OA_LIST_PATH=/api/v1/contracts/list
# OA_FETCH_PATH=/api/v1/contracts/{contract_id}/download
# OA_LIST_ITEMS_KEY=items          # 支持点号路径，如 data.records
# OA_ID_FIELD=contract_id
# OA_HASH_FIELD=content_hash       # 可不提供（小合会下载原文自行计算）
# OA_TIME_FIELD=uploaded_at
# OA_SIZE_FIELD=size
# OA_AUTH_HEADER=Authorization
# OA_AUTH_TOKEN=Bearer <token>
# OA_TIMEOUT_S=15
# OA_VERIFY_TLS=true               # 内网自签证书可临时 false（不推荐长期）

# ============================================================ 通知通道（四选一）
# mock：Mock 邮箱（演示/自检）
MAIL_GATEWAY=mock
# none：不发任何通知（离线演练）
# MAIL_GATEWAY=none
# smtp：企业邮箱直发
# MAIL_GATEWAY=smtp
# SMTP_HOST=smtp.corp.example
# SMTP_PORT=587
# SMTP_USER=compliance-bot@corp.example
# SMTP_PASSWORD=<口令>
# SMTP_FROM=compliance-bot@corp.example
# SMTP_STARTTLS=true
# http：内网邮件网关/中台
# MAIL_GATEWAY=http
# MAIL_HTTP_URL=https://mailgw.corp.example/api/send
# MAIL_AUTH_HEADER=Authorization
# MAIL_AUTH_TOKEN=Bearer <token>

# ============================================================ OCR（扫描件）
# auto：按 PaddleOCR → RapidOCR → Tesseract → HTTP OCR 服务 顺序自动挑选可用引擎
# none：显式关闭（扫描件一律转人工，行为与升级前一致）
# 内网通常已有 OCR 中台 —— 直接给 URL 即可，无需本机装模型：
OCR_ENGINE=auto
# OCR_ENGINE=http
# OCR_HTTP_URL=https://ocr.corp.example/api/v1/ocr
# OCR_HTTP_FIELD=file                  # 上传字段名
# OCR_HTTP_TEXT_PATH=data.text          # 响应里正文的取值路径（点号；不填则自动探测 text/result）
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=chi_sim+eng                  # tesseract；rapidocr 用 ch
OCR_DPI=200                             # 渲染分辨率（越大越准越慢）
OCR_MAX_PAGES=30                        # 单份文档最多 OCR 页数（防超大件拖垮）
OCR_TIMEOUT_S=60

# ============================================================ 可观测与运行
LOG_MODE=console                   # console | json（接入日志平台时用 json）
HTTP_TRUST_ENV=false               # 是否信任 X-Forwarded-For（在反向代理之后设 true）
# 日志轮转（防止长期运行把磁盘写满）
LOG_MAX_BYTES=8388608
LOG_BACKUPS=5
# 审批占用租约（秒）：进程崩溃后超过该时长可被接管，避免审批永久锁死
RUN_CLAIM_LEASE_SEC=900
# 巡检状态文件（默认 .runtime/scan-state.json；多实例部署时应各自独立或落库）
# SCAN_STATE_PATH=D:\compliance\state\scan-state.json
