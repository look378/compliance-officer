# ============================================================ 运行时与本机产物
# .runtime 里有 venv、PostgreSQL 二进制、数据库与日志（本机约 2.9 GB）——绝不入库
.runtime/

# 框架工作区与数据库：能力服务/框架若在源码树内建库会落到这里
.lemonclaw/

# 生成的审查报告（可复现，不入库）
reports/

# 规则提案是运行期审计产物：默认忽略（若团队要留档请显式取消注释并配套清理策略）
data/proposals/

# ============================================================ 密钥（最重要）
.env
.env.*
!.env.enterprise.example
*.pem
*.key
pgpw.txt
*secret*.txt

# ============================================================ Python
__pycache__/
*.py[codz]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================ 数据库/大文件
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.zip
*.7z
*.tar.gz

# ============================================================ 日志
*.log
logs/

